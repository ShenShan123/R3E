# Copy to .env, fill in values, then: set -a; source .env; set +a
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Optional provider-specific aliases used by legacy experiment runners.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional comma-separated allowlist for additional provider hosts.
# Keep empty unless a library client explicitly needs another endpoint.
R3E_ALLOWED_LLM_HOSTS=

R3E_ROOT=/absolute/path/to/R3E
R3E_SOURCE_ROOT=/absolute/path/to/R3E/r3e
R3E_ARTIFACT_ROOT=/absolute/path/to/R3E/artifacts
CIRFIX_ROOT=/absolute/path/to/cirfix
R3E_CIRFIX_SOURCE_MANIFEST=/absolute/path/to/cirfix39_source_manifest.jsonl
ORFS_ROOT=/absolute/path/to/OpenROAD-flow-scripts
RTL_DATA_ROOT=/absolute/path/to/rtl-data
R3E_RTL_ROOT=/absolute/path/to/rtl-benchmarks
R3E_POISON_ROOT=/absolute/path/to/red-team-poison-inputs
R3E_RED_PROJECT_ROOT=/absolute/path/to/read-only-red-team-inputs
R3E_RED_MEMORY_ROOT=/absolute/path/to/writable-red-team-memory
R3E_RED_SANDBOX_ROOT=/absolute/path/to/materialized-red-team-sandbox
