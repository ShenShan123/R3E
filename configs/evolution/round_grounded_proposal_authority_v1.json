{
  "schema_version": "r3e-round-interface-v1",
  "phase": "system_upgrade",
  "executable": false,
  "authority": {
    "active_policy": "formal_registry_v2",
    "runtime_input": "PolicyState",
    "red_proposal": "r3e-grounded-proposal-authority-v1",
    "validity": "grounded_runtime_authority_v1",
    "promotion": "atomic_registry_commit"
  },
  "validity_authority": "grounded_runtime_authority_v1",
  "adapter_interface": "r3e.arena.adapter.EvolutionAdapter",
  "grounded_pre_generation_planner": true,
  "grounded_red_proposal_budget": 8,
  "grounded_family_quota": 2,
  "grounded_archive_quota": 2,
  "grounded_maximum_difficulty_band": "D3",
  "grounded_allow_controlled_composition": true,
  "grounded_coverage_state": "runtime/red/grounded_coverage_state.json",
  "formal_protocols": {
    "red_search_context": "r3e-red-search-context-v6",
    "proposal_intent": "r3e-grounded-proposal-intent-v1",
    "proposal_authority": "r3e-grounded-proposal-authority-v1",
    "proposal_execution": "r3e-grounded-proposal-execution-v1",
    "coverage_plan": "r3e-grounded-coverage-plan-v1",
    "coverage_state": "r3e-red-coverage-state-v1",
    "difficulty_profile": "r3e-red-difficulty-profile-v1",
    "grounded_execution": "r3e-grounded-red-execution-bundle-v1",
    "formal_proof": "r3e-formal-proof-triplet-v1",
    "round_audit": "r3e-round-audit-v1"
  },
  "planner_permissions": {
    "reads": [
      "active-policy-hash",
      "effective-policy-hash",
      "coverage-state",
      "sanitized-archive-authority-view",
      "sanitized-memory-capability"
    ],
    "freezes": [
      "family",
      "operator",
      "runtime-effect",
      "specialist-kind",
      "difficulty-target",
      "lineage-class",
      "archive-quota",
      "dispatch-kind"
    ],
    "forbids": [
      "prompt",
      "patch",
      "reference-repair",
      "private-raam-evidence",
      "hidden-target",
      "validity-decision"
    ]
  },
  "deferred_experiment_bindings": [
    "model_name",
    "provider_routing",
    "experiment_seeds",
    "promotion_thresholds",
    "non_target_manifest",
    "experiment_budget"
  ],
  "note": "Deterministic pre-generation Grounded Red proposal authority only. It freezes planner and curriculum decisions before adapter execution; it does not claim real proposal yield, model quality, or GRD-8 results."
}
